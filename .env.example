DISCORD_TOKEN=dán_token_bot_vào_đây
# Tuỳ chọn: ID server để lệnh / xuất hiện ngay (không cần đợi tới 1 giờ)
GUILD_ID=
# Tuỳ chọn: điểm phù hợp tối thiểu (0-100) để được liệt kê
MIN_SCORE=25
DB_PATH=jobs.db
# Khoá SerpApi (miễn phí ~100 lượt/tháng, https://serpapi.com/manage-api-key).
# Bật quét LinkedIn, Indeed, TopCV, ITviec... qua Google Jobs.
SERPAPI_KEY=
JOB_LOCATION=Vietnam
# Khoá JSearch (LinkedIn, Indeed, Glassdoor...). Dùng MỘT trong hai:
OPENWEBNINJA_KEY=
RAPIDAPI_KEY=
JSEARCH_COUNTRY=vn
